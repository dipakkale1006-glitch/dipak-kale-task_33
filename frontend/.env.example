# ---------------------------------------------------------------------------
# To-Do List Frontend - environment variables
# Copy this file to `.env` and adjust if needed.
# Only variables prefixed with VITE_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Base URL of the backend API.
#
# Option A - Behind the Vite dev proxy (default, no CORS needed in development).
#   The dev server forwards /api/* to http://localhost:5000 (see vite.config.js).
VITE_API_URL=/api

# Option B - Point the frontend straight at a running backend.
#   Useful when you want to test against a deployed API from your machine.
# VITE_API_URL=http://localhost:5000/api

# Option C - Production backend on Render.
# VITE_API_URL=https://your-todo-api.onrender.com/api

# Dev-server proxy target (only used by the proxy in vite.config.js).
VITE_PROXY_TARGET=http://localhost:5000
