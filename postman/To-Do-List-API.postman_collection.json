{
  "info": {
    "name": "To-Do List API",
    "description": "REST API for the MERN stack To-Do List app (Node.js + Express.js + MongoDB).\n\n### How to use\n1. Import this collection and the matching environment (`To-Do-List-API.postman_environment.json`).\n2. Select the environment in the top-right dropdown.\n3. Start the backend (`npm run dev`).\n4. Run **Create Task** first - it stores the returned id in the `taskId` variable for the requests that follow.\n\nBase URL comes from the `baseUrl` environment variable (default `http://localhost:5000/api`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Service and database health probe. Returns 200 with `database: \"connected\"` when Mongo is reachable."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response has success envelope', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.be.true;",
              "  pm.expect(body.data.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Finish the MERN assignment\",\n  \"description\": \"Write the README and deploy to Render and Netlify\",\n  \"priority\": \"high\",\n  \"category\": \"study\",\n  \"dueDate\": \"2026-11-01T18:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            },
            "description": "Creates a task. Only `title` is required. The server generates the ObjectId and the timestamps and returns the saved task."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the created task with an id', () => {",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.data.id).to.be.a('string');",
                  "  pm.expect(body.data.completed).to.be.false;",
                  "});",
                  "pm.collectionVariables.set('taskId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Task - Validation Error (missing title)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"This request has no title on purpose\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            },
            "description": "Negative case: a missing title must produce 400 with a per-field error list."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('Reports VALIDATION_ERROR with field details', () => {",
                  "  pm.expect(body.success).to.be.false;",
                  "  pm.expect(body.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(body.errors[0].field).to.eql('title');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            },
            "description": "Returns every task ordered pending-first, newest-first, together with pagination metadata."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns an array with pagination meta', () => {",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.meta).to.have.property('total');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Tasks - Filters, Search and Sort",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks?completed=false&priority=high&search=assignment&sort=-createdAt&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "completed", "value": "false", "description": "true | false" },
                { "key": "priority", "value": "high", "description": "low | medium | high" },
                { "key": "search", "value": "assignment", "description": "Case-insensitive text search" },
                { "key": "sort", "value": "-createdAt", "description": "Prefix with - for descending" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10", "description": "Max 100" }
              ]
            },
            "description": "Demonstrates every supported query parameter. Remove the ones you do not need."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Respects the limit parameter', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.length).to.be.at.most(10);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Task Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/stats",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "stats"]
            },
            "description": "Aggregate counts for the UI summary: total, completed and pending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns numeric counters', () => {",
                  "  pm.expect(body.data).to.have.all.keys('total', 'completed', 'pending');",
                  "  pm.expect(body.data.total).to.eql(body.data.completed + body.data.pending);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Task by Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "Fetches one task. `{{taskId}}` is set automatically by the *Create Task* request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns the requested task', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.id).to.eql(pm.collectionVariables.get('taskId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Task - Invalid Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/not-a-valid-id",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "not-a-valid-id"]
            },
            "description": "Negative case: a malformed id must return 400 INVALID_ID rather than crashing with a 500."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Reports INVALID_ID', () => {",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_ID');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Task (PUT - full update)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Finish the MERN assignment (revised)\",\n  \"description\": \"Docs done, deployment in progress\",\n  \"completed\": false,\n  \"priority\": \"medium\",\n  \"category\": \"study\",\n  \"dueDate\": \"2026-11-02T18:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "Replaces the resource. Fields omitted from the body fall back to their defaults - that is standard PUT behaviour."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Applies the new values', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.title).to.include('revised');",
                  "  pm.expect(body.data.priority).to.eql('medium');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Task Status (PATCH - toggle completed)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completed\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "Partial update - this is the call the UI checkbox makes. Only the supplied fields change."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Marks the task as completed', () => {",
                  "  pm.expect(pm.response.json().data.completed).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Task (PATCH - change priority)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"low\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "Shows that a single field can be changed without sending the whole task."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Priority updated and title untouched', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.priority).to.eql('low');",
                  "  pm.expect(body.data.title).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Task - Invalid Priority",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"urgent\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "Negative case: the priority enum must be enforced."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Reports the priority field', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.errors.some((e) => e.field === 'priority')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete All Completed Tasks",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks?completed=true",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "completed", "value": "true", "description": "Required - which subset to delete" }
              ]
            },
            "description": "Bulk delete used by the *Clear completed* button. The `completed` parameter is mandatory so a missing value can never wipe the collection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Reports how many tasks were removed', () => {",
                  "  pm.expect(pm.response.json().data).to.have.property('count');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "Deletes a single task and returns its id for confirmation. Run the create request again before using this, since it consumes `{{taskId}}`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Confirms the deleted id', () => {",
                  "  pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('taskId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Task - Second Attempt (404)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "Negative case: deleting an already deleted task must return 404, not 500."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Reports NOT_FOUND', () => {",
                  "  pm.expect(pm.response.json().code).to.eql('NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "Unknown Route (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/does-not-exist",
              "host": ["{{baseUrl}}"],
              "path": ["does-not-exist"]
            },
            "description": "Verifies the fallback 404 handler returns the standard error envelope."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Uses the standard error envelope', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.false;",
                  "  pm.expect(body.code).to.eql('NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "taskId", "value": "" }
  ]
}
