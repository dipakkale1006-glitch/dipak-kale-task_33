# ---------------------------------------------------------------------------
# To-Do List API - environment variables
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit the real `.env` file (it is already in .gitignore).
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------------
# MongoDB connection string
# ---------------------------------------------------------------------------

# Option A - Local MongoDB (default in development)
# Requires a MongoDB server running on your machine.
MONGODB_URI=mongodb://127.0.0.1:27017/todoapp

# Option B - MongoDB Atlas (recommended for production / Render)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/todoapp?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# CORS - comma separated list of allowed frontend origins
# In development the Vite dev server runs on http://localhost:5173
# In production add your Netlify URL, e.g. https://my-todo-app.netlify.app
# Leave empty to allow every origin (development only).
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting: max requests per IP inside RATE_LIMIT_WINDOW_MS
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
