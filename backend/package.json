{
  "name": "todo-backend",
  "version": "1.0.0",
  "description": "REST API backend for the To-Do List app (Node.js + Express.js + MongoDB).",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:memory": "node src/scripts/devMemory.js",
    "test": "node --test test/api.test.js",
    "seed": "node src/scripts/seed.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "rest-api",
    "todo"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
